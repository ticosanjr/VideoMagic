{
  "schema_version": 1,
  "id": "recut_replacement",
  "name": "Recut Replacement",
  "description": "Remove silence with detailed VAD controls, choose a hard/J/L cut, and export MP4 plus Resolve, Premiere, and Kdenlive timelines.",
  "llm": {
    "provider": "none",
    "base_url": null,
    "model": "",
    "api_key_env": "VIDEOWFLOW_LLM_API_KEY",
    "timeout_seconds": 90.0
  },
  "ui": {
    "version": 1,
    "viewport": {
      "x": 0.0,
      "y": 0.0,
      "zoom": 1.0
    },
    "nodes": {}
  },
  "variables": {},
  "profiles": {},
  "variants": [],
  "steps": [
    {
      "id": "ingest",
      "type": "ingest",
      "needs": [],
      "inputs": {},
      "enabled": true,
      "params": {
        "extract_pcm": true
      }
    },
    {
      "id": "vad",
      "type": "audio.vad",
      "needs": [
        "ingest"
      ],
      "inputs": {
        "media": "ingest.media"
      },
      "enabled": true,
      "params": {
        "engine": "auto",
        "noise_db": -30.0,
        "speech_threshold": 0.5,
        "min_silence_ms": 350,
        "min_speech_ms": 120,
        "spike_suppression_ms": 180,
        "merge_gap_ms": 120,
        "pad_before_ms": 80,
        "pad_after_ms": 120,
        "apply_pads": false
      }
    },
    {
      "id": "timeline",
      "type": "edit.timeline",
      "needs": [
        "vad"
      ],
      "inputs": {
        "speech": "vad.speech"
      },
      "enabled": true,
      "params": {
        "cut_mode": "hard",
        "enable_j_cuts": false,
        "enable_l_cuts": false,
        "offset_ms": 200,
        "audio_crossfade_ms": 20,
        "fade_in_ms": 20,
        "fade_out_ms": 20,
        "handle_check": true,
        "transition_frames": 0,
        "transition_type": "crossfade",
        "zoom_mode": "manual_rules"
      }
    },
    {
      "id": "export",
      "type": "export.nle",
      "needs": [
        "timeline"
      ],
      "inputs": {
        "timeline": "timeline.timeline"
      },
      "enabled": true,
      "params": {
        "targets": [
          "mp4",
          "resolve",
          "premiere",
          "kdenlive"
        ]
      }
    }
  ]
}
