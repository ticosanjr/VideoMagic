{
  "schema_version": 1,
  "id": "opusclip_auto_shorts",
  "name": "OpusClip-style Auto Shorts",
  "description": "Long-form ingest, audio cleanup, transcript, viral Short selection, active reframe, kinetic captions, render, and NLE export.",
  "llm": {
    "provider": "auto",
    "base_url": null,
    "model": "",
    "api_key_env": "VIDEOWFLOW_LLM_API_KEY",
    "timeout_seconds": 90.0
  },
  "variables": {},
  "profiles": {},
  "variants": [],
  "steps": [
    {
      "id": "ingest",
      "type": "ingest",
      "needs": [],
      "params": {
        "extract_pcm": true
      }
    },
    {
      "id": "vad",
      "type": "audio.vad",
      "needs": ["ingest"],
      "params": {
        "engine": "auto",
        "min_silence_ms": 400,
        "min_speech_ms": 100
      }
    },
    {
      "id": "audio_master",
      "type": "audio.master",
      "needs": ["ingest"],
      "params": {
        "highpass_hz": 80,
        "denoise": true,
        "denoise_db": 12,
        "noise_floor_db": -30,
        "loudnorm": true,
        "target_lufs": -14.0,
        "true_peak_db": -1.5
      }
    },
    {
      "id": "audio_isolate",
      "type": "audio.isolate",
      "needs": ["audio_master"],
      "params": {
        "backend": "auto",
        "fallback_to_master": true,
        "sample_rate": 48000
      }
    },
    {
      "id": "transcribe",
      "type": "transcribe",
      "needs": ["ingest", "audio_isolate"],
      "params": {
        "mode": "auto",
        "model_size": "large-v3",
        "language": "auto",
        "vad_filter": true,
        "audio_source": "isolated"
      }
    },
    {
      "id": "diarize",
      "type": "audio.diarize",
      "needs": ["transcribe"],
      "params": {
        "method": "pyannote",
        "fallback_to_heuristic": true,
        "max_speakers": 4
      }
    },
    {
      "id": "retakes",
      "type": "retakes.cull",
      "needs": ["vad", "transcribe"],
      "params": {
        "enabled": true,
        "strategy": "keep_last",
        "strictness": "balanced"
      }
    },
    {
      "id": "narrative",
      "type": "narrative.beats",
      "needs": ["transcribe"],
      "params": {
        "min_block_words": 80,
        "max_block_words": 300
      }
    },
    {
      "id": "shorts",
      "type": "shorts.select",
      "needs": ["transcribe", "retakes", "narrative"],
      "params": {
        "profile": "tiktok",
        "target_duration_min_sec": 30,
        "target_duration_max_sec": 60,
        "min_clips": 1,
        "max_clips_to_generate": 3,
        "selection_mode": "auto",
        "hook_mode": "reorder",
        "remove_fillers": true,
        "audio_energy_boost": true,
        "scene_change_boost": true,
        "aspect_ratio": "9:16",
        "resolution": 1080,
        "burn_subtitles": true,
        "subtitles_preset": "tiktok_bold",
        "virality_threshold": 60.0
      }
    },
    {
      "id": "score",
      "type": "shorts.score",
      "needs": ["shorts"],
      "params": {
        "profile": "tiktok",
        "top_k": 3,
        "diversity_threshold": 0.75,
        "use_llm": true,
        "score_mode": "hybrid"
      }
    },
    {
      "id": "reframe",
      "type": "shorts.reframe",
      "needs": ["score"],
      "params": {
        "mode": "face_tracking",
        "split_screen_on_dialogue": true,
        "tracking_backend": "auto",
        "smoothing_factor": 0.85,
        "dynamic_crop": true,
        "layout": "single"
      }
    },
    {
      "id": "captions",
      "type": "shorts.captions",
      "needs": ["shorts"],
      "params": {
        "enabled": true,
        "preset": "hormozi_bold",
        "caption_style": {
          "font_family": "Arial",
          "font_size": 72,
          "font_weight": "bold",
          "uppercase": true,
          "primary_color": "#FFFFFF",
          "highlight_color": "#00FF66",
          "outline_color": "#000000",
          "outline_width": 4,
          "position_y": 0.78,
          "max_width": 0.9,
          "animation": "pop",
          "word_timing": "engine",
          "keyword_highlight_enabled": true,
          "keyword_color": "#00E5FF",
          "emoji_enabled": true,
          "speaker_colors": ["#FFFFFF", "#00E5FF", "#FFD400", "#FF6B6B"]
        }
      }
    },
    {
      "id": "render_shorts",
      "type": "shorts.render",
      "needs": ["reframe", "captions"],
      "params": {
        "burn_subtitles": true,
        "broll_enabled": false
      }
    },
    {
      "id": "timeline",
      "type": "edit.timeline",
      "needs": ["vad", "retakes"],
      "params": {
        "cut_mode": "j_cut",
        "enable_j_cuts": true,
        "offset_ms": 200
      }
    },
    {
      "id": "metadata",
      "type": "metadata.pack",
      "needs": ["score"],
      "params": {
        "platform": "youtube",
        "platforms": ["youtube", "tiktok", "instagram"],
        "tone": "engaging"
      }
    },
    {
      "id": "export",
      "type": "export.nle",
      "needs": ["timeline", "render_shorts"],
      "params": {
        "targets": ["resolve", "premiere", "kdenlive", "edl"],
        "require_licenses": true
      }
    }
  ]
}
