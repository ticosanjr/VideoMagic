{
  "schema_version": 1,
  "id": "opusclip_nle_bridge",
  "name": "OpusClip-style NLE Bridge",
  "description": "Long-form timeline with chapters, FCPXML/XMEML/Kdenlive exports, NLE QA, Shorts metadata, and a delivery package.",
  "llm": {
    "provider": "auto",
    "base_url": null,
    "model": "",
    "api_key_env": "VIDEOWFLOW_LLM_API_KEY",
    "timeout_seconds": 90.0
  },
  "variables": {},
  "profiles": {},
  "variants": [],
  "steps": [
    {
      "id": "ingest",
      "type": "ingest",
      "needs": [],
      "params": {
        "extract_pcm": true
      }
    },
    {
      "id": "vad",
      "type": "audio.vad",
      "needs": ["ingest"],
      "params": {
        "engine": "auto"
      }
    },
    {
      "id": "transcribe",
      "type": "transcribe",
      "needs": ["ingest"],
      "params": {
        "mode": "auto",
        "model_size": "large-v3",
        "language": "auto",
        "vad_filter": true
      }
    },
    {
      "id": "retakes",
      "type": "retakes.cull",
      "needs": ["vad", "transcribe"],
      "params": {
        "enabled": true
      }
    },
    {
      "id": "narrative",
      "type": "narrative.beats",
      "needs": ["transcribe"],
      "params": {
        "min_block_words": 80,
        "max_block_words": 300
      }
    },
    {
      "id": "chapters",
      "type": "chapters.plan",
      "needs": ["transcribe"],
      "params": {
        "max_chapters": 12,
        "use_llm": true
      }
    },
    {
      "id": "timeline",
      "type": "edit.timeline",
      "needs": ["vad", "retakes"],
      "params": {
        "cut_mode": "j_cut",
        "enable_j_cuts": true,
        "offset_ms": 200
      }
    },
    {
      "id": "shorts",
      "type": "shorts.select",
      "needs": ["transcribe", "retakes", "narrative"],
      "params": {
        "profile": "tiktok",
        "target_duration_min_sec": 30,
        "target_duration_max_sec": 60,
        "min_clips": 1,
        "max_clips_to_generate": 3,
        "selection_mode": "auto",
        "hook_mode": "reorder",
        "aspect_ratio": "9:16",
        "resolution": 1080,
        "subtitles_preset": "tiktok_bold"
      }
    },
    {
      "id": "score",
      "type": "shorts.score",
      "needs": ["shorts"],
      "params": {
        "profile": "tiktok",
        "top_k": 3,
        "score_mode": "hybrid"
      }
    },
    {
      "id": "render_shorts",
      "type": "shorts.render",
      "needs": ["score"],
      "params": {
        "burn_subtitles": true,
        "broll_enabled": false
      }
    },
    {
      "id": "metadata",
      "type": "metadata.pack",
      "needs": ["score"],
      "params": {
        "platform": "youtube",
        "platforms": ["youtube", "tiktok", "instagram"],
        "tone": "engaging"
      }
    },
    {
      "id": "thumbnails",
      "type": "thumbnail.pack",
      "needs": ["render_shorts"],
      "params": {
        "variants": 3
      }
    },
    {
      "id": "export",
      "type": "export.nle",
      "needs": ["timeline"],
      "params": {
        "targets": ["resolve", "premiere", "kdenlive", "edl"],
        "require_licenses": true
      }
    },
    {
      "id": "qa",
      "type": "nle.qa",
      "needs": ["export"],
      "params": {}
    },
    {
      "id": "delivery",
      "type": "delivery.package",
      "needs": ["render_shorts", "thumbnails", "metadata", "qa"],
      "params": {
        "copy_thumbnail": true,
        "include_music": true,
        "include_sfx": true
      }
    }
  ]
}
