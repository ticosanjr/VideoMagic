{
  "schema_version": 1,
  "id": "recut_social",
  "name": "Recut Social",
  "description": "Tight social recut with retakes, short handles, and L-cuts.",
  "llm": {
    "provider": "none",
    "base_url": null,
    "model": "",
    "api_key_env": "VIDEOWFLOW_LLM_API_KEY",
    "timeout_seconds": 90.0
  },
  "ui": {
    "version": 1,
    "viewport": {
      "x": 0.0,
      "y": 0.0,
      "zoom": 1.0
    },
    "nodes": {}
  },
  "variables": {},
  "profiles": {},
  "variants": [],
  "steps": [
    {
      "id": "ingest",
      "type": "ingest",
      "needs": [],
      "inputs": {},
      "media_override": "",
      "output_mode": "pipeline",
      "output_dir": "",
      "enabled": true,
      "params": {
        "extract_pcm": true
      }
    },
    {
      "id": "vad",
      "type": "audio.vad",
      "needs": [
        "ingest"
      ],
      "inputs": {
        "media": "ingest.media"
      },
      "media_override": "",
      "output_mode": "pipeline",
      "output_dir": "",
      "enabled": true,
      "params": {
        "engine": "auto",
        "noise_db": -24.0,
        "speech_threshold": 0.62,
        "min_silence_ms": 240,
        "min_speech_ms": 90,
        "spike_suppression_ms": 120,
        "merge_gap_ms": 70,
        "pad_before_ms": 40,
        "pad_after_ms": 60,
        "apply_pads": false
      }
    },
    {
      "id": "transcribe",
      "type": "transcribe",
      "needs": [
        "ingest"
      ],
      "inputs": {
        "media": "ingest.media"
      },
      "media_override": "",
      "output_mode": "pipeline",
      "output_dir": "",
      "enabled": true,
      "params": {
        "mode": "auto",
        "language": "pt",
        "model_size": "small"
      }
    },
    {
      "id": "retakes",
      "type": "retakes.cull",
      "needs": [
        "vad",
        "transcribe"
      ],
      "inputs": {
        "speech": "vad.speech",
        "transcript": "transcribe.transcript"
      },
      "media_override": "",
      "output_mode": "pipeline",
      "output_dir": "",
      "enabled": true,
      "params": {
        "enabled": true,
        "strategy": "keep_last",
        "strictness": "balanced"
      }
    },
    {
      "id": "timeline",
      "type": "edit.timeline",
      "needs": [
        "vad",
        "retakes"
      ],
      "inputs": {
        "speech": "retakes.speech",
        "transcript": "transcribe.transcript"
      },
      "media_override": "",
      "output_mode": "pipeline",
      "output_dir": "",
      "enabled": true,
      "params": {
        "cut_mode": "l_cut",
        "enable_j_cuts": false,
        "enable_l_cuts": true,
        "offset_ms": 180,
        "audio_crossfade_ms": 15,
        "fade_in_ms": 20,
        "fade_out_ms": 20,
        "handle_check": true,
        "transition_frames": 0,
        "transition_type": "crossfade",
        "zoom_mode": "manual_rules"
      }
    },
    {
      "id": "export",
      "type": "export.nle",
      "needs": [
        "timeline"
      ],
      "inputs": {
        "timeline": "timeline.timeline"
      },
      "media_override": "",
      "output_mode": "pipeline",
      "output_dir": "",
      "enabled": true,
      "params": {
        "targets": [
          "mp4",
          "resolve",
          "premiere",
          "kdenlive"
        ]
      }
    }
  ]
}
