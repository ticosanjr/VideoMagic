{
  "schema_version": 1,
  "id": "localized_shorts",
  "name": "Localized Shorts",
  "description": "Viral Shorts plus an optional translated dub per Short when a TTS provider is configured.",
  "llm": {
    "provider": "none",
    "base_url": null,
    "model": "",
    "api_key_env": "VIDEOWFLOW_LLM_API_KEY",
    "timeout_seconds": 90.0
  },
  "ui": {
    "version": 1,
    "viewport": {
      "x": 0.0,
      "y": 0.0,
      "zoom": 1.0
    },
    "nodes": {}
  },
  "variables": {},
  "profiles": {},
  "variants": [],
  "steps": [
    {
      "id": "ingest",
      "type": "ingest",
      "needs": [],
      "enabled": true,
      "params": {
        "extract_pcm": true
      }
    },
    {
      "id": "vad",
      "type": "audio.vad",
      "needs": [
        "ingest"
      ],
      "enabled": true,
      "params": {}
    },
    {
      "id": "transcribe",
      "type": "transcribe",
      "needs": [
        "ingest"
      ],
      "enabled": true,
      "params": {
        "mode": "auto",
        "language": "pt",
        "model_size": "small"
      }
    },
    {
      "id": "translation",
      "type": "transcript.translate",
      "needs": [
        "transcribe"
      ],
      "enabled": true,
      "params": {
        "target_language": "en"
      }
    },
    {
      "id": "retakes",
      "type": "retakes.cull",
      "needs": [
        "vad",
        "transcribe"
      ],
      "enabled": true,
      "params": {
        "enabled": true
      }
    },
    {
      "id": "timeline",
      "type": "edit.timeline",
      "needs": [
        "vad",
        "retakes"
      ],
      "enabled": true,
      "params": {}
    },
    {
      "id": "shorts",
      "type": "shorts.select",
      "needs": [
        "transcribe",
        "retakes"
      ],
      "enabled": true,
      "params": {
        "target_duration_min_sec": 30,
        "target_duration_max_sec": 60,
        "min_clips": 1,
        "max_clips_to_generate": 3,
        "selection_mode": "auto",
        "burn_subtitles": true
      }
    },
    {
      "id": "score",
      "type": "shorts.score",
      "needs": [
        "shorts"
      ],
      "enabled": true,
      "params": {
        "profile": "default",
        "top_k": 3
      }
    },
    {
      "id": "reframe",
      "type": "shorts.reframe",
      "needs": [
        "score"
      ],
      "enabled": true,
      "params": {
        "mode": "center_crop_9_16"
      }
    },
    {
      "id": "captions",
      "type": "shorts.captions",
      "needs": [
        "score"
      ],
      "enabled": true,
      "params": {
        "enabled": true
      }
    },
    {
      "id": "render_shorts",
      "type": "shorts.render",
      "needs": [
        "reframe",
        "captions"
      ],
      "enabled": true,
      "params": {
        "burn_subtitles": true
      }
    },
    {
      "id": "dub",
      "type": "localization.dub",
      "needs": [
        "render_shorts"
      ],
      "enabled": true,
      "params": {
        "target_language": "en",
        "original_volume": 0.15
      }
    },
    {
      "id": "export",
      "type": "export.nle",
      "needs": [
        "timeline",
        "render_shorts"
      ],
      "enabled": true,
      "params": {
        "targets": [
          "resolve",
          "premiere",
          "kdenlive"
        ]
      }
    }
  ]
}
