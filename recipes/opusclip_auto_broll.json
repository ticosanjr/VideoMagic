{
  "schema_version": 1,
  "id": "opusclip_auto_broll",
  "name": "OpusClip-style Auto B-roll",
  "description": "Viral Shorts with entity-aware stock or local B-roll planning, reframing, kinetic captions, render, and NLE export.",
  "llm": {
    "provider": "none",
    "base_url": null,
    "model": "",
    "api_key_env": "VIDEOWFLOW_LLM_API_KEY",
    "timeout_seconds": 90.0
  },
  "variables": {
    "broll_provider": {
      "type": "enum",
      "default": "pexels",
      "options": ["pexels", "local"],
      "description": "B-roll source. local requires broll_asset_dir."
    },
    "broll_asset_dir": {
      "type": "string",
      "default": "",
      "description": "Local B-roll folder when broll_provider is local."
    }
  },
  "profiles": {},
  "variants": [],
  "steps": [
    {
      "id": "ingest",
      "type": "ingest",
      "needs": [],
      "params": {
        "extract_pcm": true
      }
    },
    {
      "id": "vad",
      "type": "audio.vad",
      "needs": ["ingest"],
      "params": {
        "engine": "auto",
        "min_silence_ms": 400
      }
    },
    {
      "id": "transcribe",
      "type": "transcribe",
      "needs": ["ingest"],
      "params": {
        "mode": "auto",
        "model_size": "large-v3",
        "language": "auto",
        "vad_filter": true
      }
    },
    {
      "id": "retakes",
      "type": "retakes.cull",
      "needs": ["vad", "transcribe"],
      "params": {
        "enabled": true,
        "strategy": "keep_last"
      }
    },
    {
      "id": "narrative",
      "type": "narrative.beats",
      "needs": ["transcribe"],
      "params": {
        "min_block_words": 80,
        "max_block_words": 300
      }
    },
    {
      "id": "shorts",
      "type": "shorts.select",
      "needs": ["transcribe", "retakes", "narrative"],
      "params": {
        "profile": "tiktok",
        "target_duration_min_sec": 30,
        "target_duration_max_sec": 60,
        "min_clips": 1,
        "max_clips_to_generate": 3,
        "selection_mode": "auto",
        "hook_mode": "reorder",
        "remove_fillers": true,
        "audio_energy_boost": true,
        "scene_change_boost": true,
        "aspect_ratio": "9:16",
        "resolution": 1080,
        "burn_subtitles": true,
        "subtitles_preset": "tiktok_bold",
        "virality_threshold": 60.0
      }
    },
    {
      "id": "score",
      "type": "shorts.score",
      "needs": ["shorts"],
      "params": {
        "profile": "tiktok",
        "top_k": 3,
        "use_llm": true
      }
    },
    {
      "id": "broll_generate",
      "type": "broll.generate",
      "needs": ["score"],
      "params": {
        "base_url": "",
        "model": "flux1-schnell",
        "count": 2,
        "width": 1024,
        "height": 1024,
        "allow_external_services": false
      }
    },
    {
      "id": "broll",
      "type": "broll.plan",
      "needs": ["broll_generate"],
      "params": {
        "provider": "local",
        "asset_dir": "",
        "max_per_short": 2,
        "start_fraction": 0.2,
        "duration_sec": 3.0
      }
    },
    {
      "id": "reframe",
      "type": "shorts.reframe",
      "needs": ["score"],
      "params": {
        "mode": "face_tracking",
        "split_screen_on_dialogue": true,
        "tracking_backend": "auto",
        "smoothing_factor": 0.85,
        "dynamic_crop": true,
        "layout": "single"
      }
    },
    {
      "id": "captions",
      "type": "shorts.captions",
      "needs": ["shorts"],
      "params": {
        "enabled": true,
        "preset": "hormozi_bold",
        "caption_style": {
          "font_family": "Arial",
          "font_size": 72,
          "font_weight": "bold",
          "uppercase": true,
          "primary_color": "#FFFFFF",
          "highlight_color": "#00FF66",
          "outline_color": "#000000",
          "outline_width": 4,
          "position_y": 0.78,
          "max_width": 0.9,
          "animation": "pop",
          "word_timing": "engine",
          "keyword_highlight_enabled": true,
          "keyword_color": "#00E5FF",
          "emoji_enabled": true
        }
      }
    },
    {
      "id": "render_shorts",
      "type": "shorts.render",
      "needs": ["broll", "reframe", "captions"],
      "params": {
        "burn_subtitles": true,
        "broll_enabled": true
      }
    },
    {
      "id": "timeline",
      "type": "edit.timeline",
      "needs": ["vad", "retakes"],
      "params": {
        "cut_mode": "j_cut",
        "enable_j_cuts": true
      }
    },
    {
      "id": "export",
      "type": "export.nle",
      "needs": ["timeline", "render_shorts"],
      "params": {
        "targets": ["resolve", "premiere", "kdenlive", "edl"],
        "require_licenses": true
      }
    }
  ]
}
