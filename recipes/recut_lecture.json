{
  "schema_version": 1,
  "id": "recut_lecture",
  "name": "Recut Lecture",
  "description": "Deterministic class or webinar recut with hard cuts and wide handles.",
  "llm": {
    "provider": "none",
    "base_url": null,
    "model": "",
    "api_key_env": "VIDEOWFLOW_LLM_API_KEY",
    "timeout_seconds": 90.0
  },
  "ui": {
    "version": 1,
    "viewport": {
      "x": 0.0,
      "y": 0.0,
      "zoom": 1.0
    },
    "nodes": {}
  },
  "variables": {},
  "profiles": {},
  "variants": [],
  "steps": [
    {
      "id": "ingest",
      "type": "ingest",
      "needs": [],
      "inputs": {},
      "media_override": "",
      "output_mode": "pipeline",
      "output_dir": "",
      "enabled": true,
      "params": {
        "extract_pcm": true
      }
    },
    {
      "id": "vad",
      "type": "audio.vad",
      "needs": [
        "ingest"
      ],
      "inputs": {
        "media": "ingest.media"
      },
      "media_override": "",
      "output_mode": "pipeline",
      "output_dir": "",
      "enabled": true,
      "params": {
        "engine": "auto",
        "noise_db": -38.0,
        "speech_threshold": 0.4,
        "min_silence_ms": 650,
        "min_speech_ms": 160,
        "spike_suppression_ms": 300,
        "merge_gap_ms": 220,
        "pad_before_ms": 150,
        "pad_after_ms": 220,
        "apply_pads": false
      }
    },
    {
      "id": "timeline",
      "type": "edit.timeline",
      "needs": [
        "vad"
      ],
      "inputs": {
        "speech": "vad.speech"
      },
      "media_override": "",
      "output_mode": "pipeline",
      "output_dir": "",
      "enabled": true,
      "params": {
        "cut_mode": "hard",
        "enable_j_cuts": false,
        "enable_l_cuts": false,
        "offset_ms": 200,
        "audio_crossfade_ms": 20,
        "fade_in_ms": 20,
        "fade_out_ms": 20,
        "handle_check": true,
        "transition_frames": 0,
        "transition_type": "crossfade",
        "zoom_mode": "manual_rules"
      }
    },
    {
      "id": "export",
      "type": "export.nle",
      "needs": [
        "timeline"
      ],
      "inputs": {
        "timeline": "timeline.timeline"
      },
      "media_override": "",
      "output_mode": "pipeline",
      "output_dir": "",
      "enabled": true,
      "params": {
        "targets": [
          "mp4",
          "resolve",
          "premiere",
          "kdenlive"
        ]
      }
    }
  ]
}
