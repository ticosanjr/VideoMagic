          "type": "string"
        },
        "ducking": {
          "default": true,
          "title": "Ducking",
          "type": "boolean"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "fade_in_ms": {
          "default": 250,
          "maximum": 5000,
          "minimum": 0,
          "title": "Fade In Ms",
