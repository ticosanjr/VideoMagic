        "write_mp4": {
          "default": false,
          "title": "Write Mp4",
          "type": "boolean"
        },
        "write_otio": {
          "default": true,
          "title": "Write Otio",
          "type": "boolean"
        },
        "write_xmeml": {
          "default": true,
          "title": "Write Xmeml",
          "type": "boolean"
        }
      },
      "title": "ExportConfig",
      "type": "object"
    },
    "IngestConfig": {
      "additionalProperties": false,
      "properties": {
        "extract_audio_pcm": {
          "default": true,
          "title": "Extract Audio Pcm",
          "type": "boolean"
        },
        "force_cfr": {
          "default": true,
