{
  "$defs": {
    "ExportConfig": {
      "additionalProperties": false,
      "properties": {
        "fcpxml_dialect": {
          "default": "1.9",
          "enum": [
            "1.9",
            "1.10"
          ],
          "title": "Fcpxml Dialect",
          "type": "string"
        },
        "write_fcpxml": {
          "default": true,
          "title": "Write Fcpxml",
          "type": "boolean"
        },
        "write_mp4": {
          "default": false,
          "title": "Write Mp4",
          "type": "boolean"
        },
        "write_otio": {
          "default": true,
          "title": "Write Otio",
          "type": "boolean"
        },
        "write_xmeml": {
          "default": true,
          "title": "Write Xmeml",
          "type": "boolean"
        }
      },
      "title": "ExportConfig",
      "type": "object"
    },
    "IngestConfig": {
      "additionalProperties": false,
      "properties": {
        "extract_audio_pcm": {
          "default": true,
          "title": "Extract Audio Pcm",
          "type": "boolean"
        },
        "force_cfr": {
          "default": true,
          "title": "Force Cfr",
          "type": "boolean"
        },
        "generate_proxy": {
          "default": false,
          "title": "Generate Proxy",
          "type": "boolean"
        }
      },
      "title": "IngestConfig",
      "type": "object"
    },
    "JlCutsConfig": {
      "additionalProperties": false,
      "properties": {
        "audio_crossfade_ms": {
          "default": 20,
          "maximum": 50,
          "minimum": 10,
          "title": "Audio Crossfade Ms",
          "type": "integer"
        },
        "enable_j_cuts": {
          "default": true,
          "title": "Enable J Cuts",
          "type": "boolean"
        },
        "enable_l_cuts": {
          "default": false,
          "title": "Enable L Cuts",
          "type": "boolean"
        },
        "handle_check": {
          "default": true,
          "title": "Handle Check",
          "type": "boolean"
        },
        "offset_ms": {
          "default": 200,
          "maximum": 500,
          "minimum": 100,
          "title": "Offset Ms",
          "type": "integer"
        }
      },
      "title": "JlCutsConfig",
      "type": "object"
    },
    "ModuleEnabled": {
      "additionalProperties": false,
      "properties": {
        "export": {
          "default": true,
          "title": "Export",
          "type": "boolean"
        },
        "ingest": {
          "default": true,
          "title": "Ingest",
          "type": "boolean"
        },
        "jl_cuts": {
          "default": true,
          "title": "Jl Cuts",
          "type": "boolean"
        },
        "retakes": {
          "default": true,
          "title": "Retakes",
          "type": "boolean"
        },
        "shorts": {
          "default": true,
          "title": "Shorts",
          "type": "boolean"
        },
        "transcribe": {
          "default": true,
          "title": "Transcribe",
          "type": "boolean"
        },
        "vad": {
          "default": true,
          "title": "Vad",
          "type": "boolean"
        },
        "zooms": {
          "default": true,
          "title": "Zooms",
          "type": "boolean"
        }
      },
      "title": "ModuleEnabled",
      "type": "object"
    },
    "ModulesConfig": {
      "additionalProperties": false,
      "properties": {
        "export": {
          "$ref": "#/$defs/ExportConfig"
        },
        "ingest": {
          "$ref": "#/$defs/IngestConfig"
        },
        "jl_cuts": {
          "$ref": "#/$defs/JlCutsConfig"
        },
        "retakes": {
          "$ref": "#/$defs/RetakesConfig"
        },
        "shorts": {
          "$ref": "#/$defs/ShortsConfig"
        },
        "transcribe": {
          "$ref": "#/$defs/TranscribeConfig"
        },
        "vad": {
          "$ref": "#/$defs/VadConfig"
        },
        "zooms": {
          "$ref": "#/$defs/ZoomsConfig"
        }
      },
      "title": "ModulesConfig",
      "type": "object"
    },
    "RetakesConfig": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "default": "http://localhost:11434/v1",
          "title": "Base Url",
          "type": "string"
        },
        "context_window_sentences": {
          "default": 15,
          "maximum": 100,
          "minimum": 1,
          "title": "Context Window Sentences",
          "type": "integer"
        },
        "model_name": {
          "default": "qwen2.5:7b-instruct",
          "title": "Model Name",
          "type": "string"
        },
        "prompt_template_version": {
          "default": "retake-v1",
          "title": "Prompt Template Version",
          "type": "string"
        },
        "provider": {
          "default": "ollama",
          "enum": [
            "ollama",
            "openai_compatible"
          ],
          "title": "Provider",
          "type": "string"
        },
        "retake_strategy": {
          "default": "keep_last",
          "enum": [
            "keep_last",
            "keep_best"
          ],
          "title": "Retake Strategy",
          "type": "string"
        },
        "secret_name": {
          "default": "VIDEOWFLOW_LLM_API_KEY",
          "title": "Secret Name",
          "type": "string"
        },
        "strictness": {
          "default": "balanced",
          "enum": [
            "conservative",
            "balanced",
            "aggressive"
          ],
          "title": "Strictness",
          "type": "string"
        },
        "temperature": {
          "default": 0.0,
          "maximum": 0.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "title": "RetakesConfig",
      "type": "object"
    },
    "ShortsConfig": {
      "additionalProperties": false,
      "properties": {
        "burn_subtitles": {
          "default": true,
          "title": "Burn Subtitles",
          "type": "boolean"
        },
        "export_format": {
          "default": "both",
          "enum": [
            "fcpxml_timeline",
            "standalone_mp4",
            "both"
          ],
          "title": "Export Format",
          "type": "string"
        },
        "max_clips_to_generate": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Clips To Generate",
          "type": "integer"
        },
        "reframe_mode": {
          "default": "center_crop_9_16",
          "enum": [
            "center_crop_9_16",
            "auto_face_tracking_yolo"
          ],
          "title": "Reframe Mode",
          "type": "string"
        },
        "subtitles_preset": {
          "default": "tiktok_bold",
          "enum": [
            "tiktok_bold",
            "minimalist_box",
            "highlight_word"
          ],
          "title": "Subtitles Preset",
          "type": "string"
        },
        "target_duration_max_sec": {
          "default": 60,
          "minimum": 1,
          "title": "Target Duration Max Sec",
          "type": "integer"
        },
        "target_duration_min_sec": {
          "default": 30,
          "minimum": 1,
          "title": "Target Duration Min Sec",
          "type": "integer"
        }
      },
      "title": "ShortsConfig",
      "type": "object"
    },
    "TranscribeConfig": {
      "additionalProperties": false,
      "properties": {
        "compute_type": {
          "default": "int8",
          "enum": [
            "float16",
            "int8",
            "float32"
          ],
          "title": "Compute Type",
          "type": "string"
        },
        "device": {
          "default": "cpu",
          "enum": [
            "cuda",
            "cpu"
          ],
          "title": "Device",
          "type": "string"
        },
        "language": {
          "default": "pt",
          "enum": [
            "pt",
            "it",
            "en",
            "es",
            "auto"
          ],
          "title": "Language",
          "type": "string"
        },
        "model_size": {
          "default": "small",
          "enum": [
            "tiny",
            "base",
            "small",
            "medium",
            "large-v3"
          ],
          "title": "Model Size",
          "type": "string"
        },
        "vad_filter": {
          "default": false,
          "title": "Vad Filter",
          "type": "boolean"
        }
      },
      "title": "TranscribeConfig",
      "type": "object"
    },
    "VadConfig": {
      "additionalProperties": false,
      "properties": {
        "keep_handles_ms": {
          "default": 200,
          "minimum": 0,
          "title": "Keep Handles Ms",
          "type": "integer"
        },
        "min_silence_duration_ms": {
          "default": 400,
          "minimum": 0,
          "title": "Min Silence Duration Ms",
          "type": "integer"
        },
        "speech_pad_after_ms": {
          "default": 150,
          "minimum": 0,
          "title": "Speech Pad After Ms",
          "type": "integer"
        },
        "speech_pad_before_ms": {
          "default": 120,
          "minimum": 0,
          "title": "Speech Pad Before Ms",
          "type": "integer"
        },
        "speech_threshold": {
          "default": 0.5,
          "maximum": 0.9,
          "minimum": 0.1,
          "title": "Speech Threshold",
          "type": "number"
        }
      },
      "title": "VadConfig",
      "type": "object"
    },
    "ZoomsConfig": {
      "additionalProperties": false,
      "properties": {
        "anchor_point": {
          "default": "upper_third",
          "enum": [
            "center",
            "upper_third",
            "face_detect"
          ],
          "title": "Anchor Point",
          "type": "string"
        },
        "mode": {
          "default": "alternate_cuts",
          "enum": [
            "alternate_cuts",
            "topic_change",
            "manual_rules"
          ],
          "title": "Mode",
          "type": "string"
        },
        "pan_direction": {
          "default": "none",
          "enum": [
            "none",
            "left_to_right",
            "right_to_left"
          ],
          "title": "Pan Direction",
          "type": "string"
        },
        "progressive_zoom": {
          "default": false,
          "title": "Progressive Zoom",
          "type": "boolean"
        },
        "punch_in_scale": {
          "default": 1.15,
          "maximum": 1.3,
          "minimum": 1.05,
          "title": "Punch In Scale",
          "type": "number"
        }
      },
      "title": "ZoomsConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "module_enabled": {
      "$ref": "#/$defs/ModuleEnabled"
    },
    "modules_config": {
      "$ref": "#/$defs/ModulesConfig"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    }
  },
  "required": [
    "name",
    "description"
  ],
  "title": "Preset",
  "type": "object"
}
