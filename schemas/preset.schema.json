{
  "$defs": {
    "AudioEnhanceConfig": {
      "additionalProperties": false,
      "properties": {
        "denoise": {
          "default": true,
          "title": "Denoise",
          "type": "boolean"
        },
        "denoise_db": {
          "default": 12,
          "maximum": 30,
          "minimum": 1,
          "title": "Denoise Db",
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "highpass_hz": {
          "default": 80,
          "maximum": 500,
          "minimum": 20,
          "title": "Highpass Hz",
          "type": "integer"
        },
        "loudnorm": {
          "default": true,
          "title": "Loudnorm",
          "type": "boolean"
        },
        "noise_floor_db": {
          "default": -30,
          "maximum": -5,
          "minimum": -80,
          "title": "Noise Floor Db",
          "type": "integer"
        },
        "target_lufs": {
          "default": -16.0,
          "maximum": -8.0,
          "minimum": -30.0,
          "title": "Target Lufs",
          "type": "number"
        },
        "true_peak_db": {
          "default": -1.5,
          "maximum": 0.0,
          "minimum": -9.0,
          "title": "True Peak Db",
          "type": "number"
        }
      },
      "title": "AudioEnhanceConfig",
      "type": "object"
    },
    "CaptionStyle": {
      "additionalProperties": false,
      "description": "Burned caption/karaoke style. Colors are #RRGGBB.",
      "properties": {
        "alignment": {
          "default": 2,
          "maximum": 9,
          "minimum": 1,
          "title": "Alignment",
          "type": "integer"
        },
        "animation": {
          "default": "none",
          "enum": [
            "none",
            "pop",
            "sweep"
          ],
          "title": "Animation",
          "type": "string"
        },
        "background_color": {
          "default": "#000000",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Background Color",
          "type": "string"
        },
        "background_opacity": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Background Opacity",
          "type": "number"
        },
        "background_padding": {
          "default": 0,
          "maximum": 40,
          "minimum": 0,
          "title": "Background Padding",
          "type": "integer"
        },
        "brand_vocabulary": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Brand Vocabulary",
          "type": "object"
        },
        "censor_enabled": {
          "default": false,
          "title": "Censor Enabled",
          "type": "boolean"
        },
        "censor_replacement": {
          "default": "***",
          "maxLength": 20,
          "minLength": 1,
          "title": "Censor Replacement",
          "type": "string"
        },
        "censor_words": {
          "items": {
            "type": "string"
          },
          "title": "Censor Words",
          "type": "array"
        },
        "emoji_enabled": {
          "default": false,
          "title": "Emoji Enabled",
          "type": "boolean"
        },
        "emoji_map": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Emoji Map",
          "type": "object"
        },
        "font_family": {
          "default": "Arial",
          "minLength": 1,
          "title": "Font Family",
          "type": "string"
        },
        "font_size": {
          "default": 72,
          "maximum": 300,
          "minimum": 8,
          "title": "Font Size",
          "type": "integer"
        },
        "font_weight": {
          "default": "bold",
          "enum": [
            "normal",
            "bold"
          ],
          "title": "Font Weight",
          "type": "string"
        },
        "highlight_color": {
          "default": "#FFD400",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Highlight Color",
          "type": "string"
        },
        "italic": {
          "default": false,
          "title": "Italic",
          "type": "boolean"
        },
        "keyword_color": {
          "default": "#00E5FF",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Keyword Color",
          "type": "string"
        },
        "keyword_highlight_enabled": {
          "default": false,
          "title": "Keyword Highlight Enabled",
          "type": "boolean"
        },
        "keyword_words": {
          "items": {
            "type": "string"
          },
          "title": "Keyword Words",
          "type": "array"
        },
        "max_width": {
          "default": 0.9,
          "maximum": 1.0,
          "minimum": 0.2,
          "title": "Max Width",
          "type": "number"
        },
        "outline_color": {
          "default": "#000000",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Outline Color",
          "type": "string"
        },
        "outline_width": {
          "default": 4,
          "maximum": 20,
          "minimum": 0,
          "title": "Outline Width",
          "type": "integer"
        },
        "position_x": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Position X",
          "type": "number"
        },
        "position_y": {
          "default": 0.78,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Position Y",
          "type": "number"
        },
        "primary_color": {
          "default": "#FFFFFF",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Primary Color",
          "type": "string"
        },
        "shadow_color": {
          "default": "#000000",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Shadow Color",
          "type": "string"
        },
        "shadow_offset": {
          "default": 2,
          "maximum": 20,
          "minimum": 0,
          "title": "Shadow Offset",
          "type": "integer"
        },
        "shadow_opacity": {
          "default": 0.6,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Shadow Opacity",
          "type": "number"
        },
        "uppercase": {
          "default": false,
          "title": "Uppercase",
          "type": "boolean"
        },
        "word_timing": {
          "default": "engine",
          "enum": [
            "engine",
            "proportional",
            "sentence"
          ],
          "title": "Word Timing",
          "type": "string"
        }
      },
      "title": "CaptionStyle",
      "type": "object"
    },
    "ExportConfig": {
      "additionalProperties": false,
      "properties": {
        "fcpxml_dialect": {
          "default": "1.9",
          "enum": [
            "1.9",
            "1.10"
