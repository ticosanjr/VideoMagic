{
  "$defs": {
    "AudioSegment": {
      "additionalProperties": false,
      "properties": {
        "clip_id": {
          "minLength": 1,
          "title": "Clip Id",
          "type": "string"
        },
        "fade_curve": {
          "default": "logarithmic",
          "enum": [
            "linear",
            "logarithmic"
          ],
          "title": "Fade Curve",
          "type": "string"
        },
        "fade_in_samples": {
          "default": 0,
          "minimum": 0,
          "title": "Fade In Samples",
          "type": "integer"
        },
        "fade_out_samples": {
          "default": 0,
          "minimum": 0,
          "title": "Fade Out Samples",
          "type": "integer"
        },
        "source_in_sample": {
          "minimum": 0,
          "title": "Source In Sample",
          "type": "integer"
        },
        "source_out_sample": {
          "minimum": 0,
          "title": "Source Out Sample",
          "type": "integer"
        },
        "timeline_in_sample": {
          "minimum": 0,
          "title": "Timeline In Sample",
          "type": "integer"
        },
        "timeline_out_sample": {
          "minimum": 0,
          "title": "Timeline Out Sample",
          "type": "integer"
        }
      },
      "required": [
        "clip_id",
        "source_in_sample",
        "source_out_sample",
        "timeline_in_sample",
        "timeline_out_sample"
      ],
      "title": "AudioSegment",
      "type": "object"
    },
    "CaptionStyle": {
      "additionalProperties": false,
      "description": "Burned caption/karaoke style. Colors are #RRGGBB.",
      "properties": {
        "alignment": {
          "default": 2,
          "maximum": 9,
          "minimum": 1,
          "title": "Alignment",
          "type": "integer"
        },
        "animation": {
          "default": "none",
          "enum": [
            "none",
            "pop",
            "sweep"
          ],
          "title": "Animation",
          "type": "string"
        },
        "background_color": {
          "default": "#000000",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Background Color",
          "type": "string"
        },
        "background_opacity": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Background Opacity",
          "type": "number"
        },
        "background_padding": {
          "default": 0,
          "maximum": 40,
          "minimum": 0,
          "title": "Background Padding",
          "type": "integer"
        },
        "font_family": {
          "default": "Arial",
          "minLength": 1,
          "title": "Font Family",
          "type": "string"
        },
        "font_size": {
          "default": 72,
          "maximum": 300,
          "minimum": 8,
          "title": "Font Size",
          "type": "integer"
        },
        "font_weight": {
          "default": "bold",
          "enum": [
            "normal",
            "bold"
          ],
          "title": "Font Weight",
          "type": "string"
        },
        "highlight_color": {
          "default": "#FFD400",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Highlight Color",
          "type": "string"
        },
        "italic": {
          "default": false,
          "title": "Italic",
          "type": "boolean"
        },
        "max_width": {
          "default": 0.9,
          "maximum": 1.0,
          "minimum": 0.2,
          "title": "Max Width",
          "type": "number"
        },
        "outline_color": {
          "default": "#000000",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Outline Color",
          "type": "string"
        },
        "outline_width": {
          "default": 4,
          "maximum": 20,
          "minimum": 0,
          "title": "Outline Width",
          "type": "integer"
        },
        "position_x": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Position X",
          "type": "number"
        },
        "position_y": {
          "default": 0.78,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Position Y",
          "type": "number"
        },
        "primary_color": {
          "default": "#FFFFFF",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Primary Color",
          "type": "string"
        },
        "shadow_color": {
          "default": "#000000",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Shadow Color",
          "type": "string"
        },
        "shadow_offset": {
          "default": 2,
          "maximum": 20,
          "minimum": 0,
          "title": "Shadow Offset",
          "type": "integer"
        },
        "shadow_opacity": {
          "default": 0.6,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Shadow Opacity",
          "type": "number"
        },
        "uppercase": {
          "default": false,
          "title": "Uppercase",
          "type": "boolean"
        },
        "word_timing": {
          "default": "engine",
          "enum": [
            "engine",
            "proportional",
            "sentence"
          ],
          "title": "Word Timing",
          "type": "string"
        }
      },
      "title": "CaptionStyle",
      "type": "object"
    },
    "ExportConfig": {
      "additionalProperties": false,
      "properties": {
        "fcpxml_dialect": {
          "default": "1.9",
          "enum": [
            "1.9",
            "1.10"
          ],
          "title": "Fcpxml Dialect",
          "type": "string"
        },
        "write_fcpxml": {
          "default": true,
          "title": "Write Fcpxml",
          "type": "boolean"
        },
        "write_mp4": {
          "default": false,
          "title": "Write Mp4",
          "type": "boolean"
        },
        "write_otio": {
          "default": true,
          "title": "Write Otio",
          "type": "boolean"
        },
        "write_xmeml": {
          "default": true,
          "title": "Write Xmeml",
          "type": "boolean"
        }
      },
      "title": "ExportConfig",
      "type": "object"
    },
    "IngestConfig": {
      "additionalProperties": false,
      "properties": {
        "extract_audio_pcm": {
          "default": true,
          "title": "Extract Audio Pcm",
          "type": "boolean"
        },
        "force_cfr": {
          "default": true,
          "title": "Force Cfr",
          "type": "boolean"
        },
        "generate_proxy": {
          "default": false,
          "title": "Generate Proxy",
          "type": "boolean"
        }
      },
      "title": "IngestConfig",
      "type": "object"
    },
    "JlCutsConfig": {
      "additionalProperties": false,
      "properties": {
        "audio_crossfade_ms": {
          "default": 20,
          "maximum": 50,
          "minimum": 10,
          "title": "Audio Crossfade Ms",
          "type": "integer"
        },
        "enable_j_cuts": {
          "default": true,
          "title": "Enable J Cuts",
          "type": "boolean"
        },
        "enable_l_cuts": {
          "default": false,
          "title": "Enable L Cuts",
          "type": "boolean"
        },
        "fade_curve": {
          "default": "logarithmic",
          "enum": [
            "linear",
            "logarithmic"
          ],
          "title": "Fade Curve",
          "type": "string"
        },
        "fade_in_ms": {
          "default": 20,
          "maximum": 1000,
          "minimum": 0,
          "title": "Fade In Ms",
          "type": "integer"
        },
        "fade_out_ms": {
          "default": 20,
          "maximum": 1000,
          "minimum": 0,
          "title": "Fade Out Ms",
          "type": "integer"
        },
        "handle_check": {
          "default": true,
          "title": "Handle Check",
          "type": "boolean"
        },
        "offset_ms": {
          "default": 200,
          "maximum": 500,
          "minimum": 100,
          "title": "Offset Ms",
          "type": "integer"
        }
      },
      "title": "JlCutsConfig",
      "type": "object"
    },
    "ManualOverride": {
      "additionalProperties": false,
      "description": "A sentence override, or a word override inside that sentence.",
      "properties": {
        "action": {
          "enum": [
            "keep",
            "discard"
          ],
          "title": "Action",
          "type": "string"
        },
        "sentence_id": {
          "minimum": 0,
          "title": "Sentence Id",
          "type": "integer"
        },
        "word_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Word Index"
        }
      },
      "required": [
        "sentence_id",
        "action"
      ],
      "title": "ManualOverride",
      "type": "object"
    },
    "MediaInfo": {
      "additionalProperties": false,
      "properties": {
        "audio_sample_rate": {
          "exclusiveMinimum": 0,
          "title": "Audio Sample Rate",
          "type": "integer"
        },
        "duration_frames": {
          "minimum": 0,
          "title": "Duration Frames",
          "type": "integer"
        },
        "fps_den": {
          "exclusiveMinimum": 0,
          "title": "Fps Den",
          "type": "integer"
        },
        "fps_num": {
          "exclusiveMinimum": 0,
          "title": "Fps Num",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "start_timecode_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Start Timecode Frames",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "source_path",
        "duration_frames",
        "fps_num",
        "fps_den",
        "width",
        "height",
        "audio_sample_rate"
      ],
      "title": "MediaInfo",
      "type": "object"
    },
    "ModuleEnabled": {
      "additionalProperties": false,
      "properties": {
        "export": {
          "default": true,
          "title": "Export",
          "type": "boolean"
        },
        "ingest": {
          "default": true,
          "title": "Ingest",
          "type": "boolean"
        },
        "jl_cuts": {
          "default": true,
          "title": "Jl Cuts",
          "type": "boolean"
        },
        "retakes": {
          "default": true,
          "title": "Retakes",
          "type": "boolean"
        },
        "shorts": {
          "default": true,
          "title": "Shorts",
          "type": "boolean"
        },
        "transcribe": {
          "default": true,
          "title": "Transcribe",
          "type": "boolean"
        },
        "vad": {
          "default": true,
          "title": "Vad",
          "type": "boolean"
        },
        "zooms": {
          "default": true,
          "title": "Zooms",
          "type": "boolean"
        }
      },
      "title": "ModuleEnabled",
      "type": "object"
    },
    "ModulesConfig": {
      "additionalProperties": false,
      "properties": {
        "export": {
          "$ref": "#/$defs/ExportConfig"
        },
        "ingest": {
          "$ref": "#/$defs/IngestConfig"
        },
        "jl_cuts": {
          "$ref": "#/$defs/JlCutsConfig"
        },
        "providers": {
          "$ref": "#/$defs/ProvidersConfig"
        },
        "retakes": {
          "$ref": "#/$defs/RetakesConfig"
        },
        "shorts": {
          "$ref": "#/$defs/ShortsConfig"
        },
        "transcribe": {
          "$ref": "#/$defs/TranscribeConfig"
        },
        "vad": {
          "$ref": "#/$defs/VadConfig"
        },
        "zooms": {
          "$ref": "#/$defs/ZoomsConfig"
        }
      },
      "title": "ModulesConfig",
      "type": "object"
    },
    "ProvidersConfig": {
      "additionalProperties": false,
      "properties": {
        "allow_external_services": {
          "default": false,
          "title": "Allow External Services",
          "type": "boolean"
        },
        "allowed_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        }
      },
      "title": "ProvidersConfig",
      "type": "object"
    },
    "RetakesConfig": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "default": "http://localhost:11434/v1",
          "title": "Base Url",
          "type": "string"
        },
        "context_window_sentences": {
          "default": 15,
          "maximum": 100,
          "minimum": 1,
          "title": "Context Window Sentences",
          "type": "integer"
        },
        "model_name": {
          "default": "qwen2.5:7b-instruct",
          "title": "Model Name",
          "type": "string"
        },
        "prompt_template_version": {
          "default": "retake-v1",
          "title": "Prompt Template Version",
          "type": "string"
        },
        "provider": {
          "default": "ollama",
          "enum": [
            "ollama",
            "openai_compatible"
          ],
          "title": "Provider",
          "type": "string"
        },
        "retake_strategy": {
          "default": "keep_last",
          "enum": [
            "keep_last",
            "keep_best"
          ],
          "title": "Retake Strategy",
          "type": "string"
        },
        "secret_name": {
          "default": "VIDEOWFLOW_LLM_API_KEY",
          "title": "Secret Name",
          "type": "string"
        },
        "strictness": {
          "default": "balanced",
          "enum": [
            "conservative",
            "balanced",
            "aggressive"
          ],
          "title": "Strictness",
          "type": "string"
        },
        "temperature": {
          "default": 0.0,
          "maximum": 0.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "title": "RetakesConfig",
      "type": "object"
    },
    "SampleSpan": {
      "additionalProperties": false,
      "properties": {
        "end_sample": {
          "minimum": 0,
          "title": "End Sample",
          "type": "integer"
        },
        "start_sample": {
          "minimum": 0,
          "title": "Start Sample",
          "type": "integer"
        }
      },
      "required": [
        "start_sample",
        "end_sample"
      ],
      "title": "SampleSpan",
      "type": "object"
    },
    "Sentence": {
      "additionalProperties": false,
      "properties": {
        "end_sample": {
          "minimum": 0,
          "title": "End Sample",
          "type": "integer"
        },
        "id": {
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "start_sample": {
          "minimum": 0,
          "title": "Start Sample",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/WordTiming"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "id",
        "start_sample",
        "end_sample",
        "text"
      ],
      "title": "Sentence",
      "type": "object"
    },
    "ShortsConfig": {
      "additionalProperties": false,
      "properties": {
        "aspect_ratio": {
          "default": "9:16",
          "enum": [
            "9:16",
            "1:1",
            "16:9"
          ],
          "title": "Aspect Ratio",
          "type": "string"
        },
        "burn_subtitles": {
          "default": true,
          "title": "Burn Subtitles",
          "type": "boolean"
        },
        "caption_style": {
          "$ref": "#/$defs/CaptionStyle"
        },
        "export_format": {
          "default": "both",
          "enum": [
            "fcpxml_timeline",
            "standalone_mp4",
            "both"
          ],
          "title": "Export Format",
          "type": "string"
        },
        "max_clips_to_generate": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Clips To Generate",
          "type": "integer"
        },
        "min_clips": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Min Clips",
          "type": "integer"
        },
        "prompt": {
          "default": "",
          "maxLength": 2000,
          "title": "Prompt",
          "type": "string"
        },
        "prompt_mode": {
          "default": "replace",
          "enum": [
            "replace",
            "refine"
          ],
          "title": "Prompt Mode",
          "type": "string"
        },
        "reframe_mode": {
          "default": "center_crop_9_16",
          "enum": [
            "center_crop_9_16",
            "auto_face_tracking_yolo"
          ],
          "title": "Reframe Mode",
          "type": "string"
        },
        "reprompt": {
          "default": "",
          "maxLength": 2000,
          "title": "Reprompt",
          "type": "string"
        },
        "selection_mode": {
          "default": "auto",
          "enum": [
            "auto",
            "llm",
            "heuristic"
          ],
          "title": "Selection Mode",
          "type": "string"
        },
        "source_end_sec": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source End Sec"
        },
        "source_start_sec": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Source Start Sec",
          "type": "number"
        },
        "subtitles_preset": {
          "default": "tiktok_bold",
          "enum": [
            "tiktok_bold",
            "minimalist_box",
            "highlight_word"
          ],
          "title": "Subtitles Preset",
          "type": "string"
        },
        "target_duration_max_sec": {
          "default": 60,
          "minimum": 1,
          "title": "Target Duration Max Sec",
          "type": "integer"
        },
        "target_duration_min_sec": {
          "default": 30,
          "minimum": 1,
          "title": "Target Duration Min Sec",
          "type": "integer"
        }
      },
      "title": "ShortsConfig",
      "type": "object"
    },
    "TranscribeConfig": {
      "additionalProperties": false,
      "properties": {
        "compute_type": {
          "default": "int8",
          "enum": [
            "float16",
            "int8",
            "float32"
          ],
          "title": "Compute Type",
          "type": "string"
        },
        "device": {
          "default": "cpu",
          "enum": [
            "cuda",
            "cpu"
          ],
          "title": "Device",
          "type": "string"
        },
        "engine": {
          "default": "auto",
          "enum": [
            "auto",
            "faster-whisper",
            "whisper.cpp"
          ],
          "title": "Engine",
          "type": "string"
        },
        "language": {
          "default": "pt",
          "enum": [
            "pt",
            "it",
            "en",
            "es",
            "auto"
          ],
          "title": "Language",
          "type": "string"
        },
        "model_size": {
          "default": "small",
          "enum": [
            "tiny",
            "base",
            "small",
            "medium",
            "large-v3"
          ],
          "title": "Model Size",
          "type": "string"
        },
        "vad_filter": {
          "default": false,
          "title": "Vad Filter",
          "type": "boolean"
        }
      },
      "title": "TranscribeConfig",
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "default": "upper_third",
          "enum": [
            "center",
            "upper_third",
            "face_detect"
          ],
          "title": "Anchor",
          "type": "string"
        },
        "pan_direction": {
          "default": "none",
          "enum": [
            "none",
            "left_to_right",
            "right_to_left"
          ],
          "title": "Pan Direction",
          "type": "string"
        },
        "pos_x": {
          "default": 0.0,
          "title": "Pos X",
          "type": "number"
        },
        "pos_y": {
          "default": 0.0,
          "title": "Pos Y",
          "type": "number"
        },
        "scale": {
          "default": 1.0,
          "maximum": 4.0,
          "minimum": 1.0,
          "title": "Scale",
          "type": "number"
        },
        "type": {
          "default": "none",
          "enum": [
            "none",
            "punch_in",
            "slow_zoom_in",
            "slow_zoom_out",
            "pan"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "title": "Transform",
      "type": "object"
    },
    "VadConfig": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "default": "auto",
          "enum": [
            "auto",
            "silero",
            "ffmpeg"
          ],
          "title": "Engine",
          "type": "string"
        },
        "keep_handles_ms": {
          "default": 200,
          "minimum": 0,
          "title": "Keep Handles Ms",
          "type": "integer"
        },
        "min_silence_duration_ms": {
          "default": 400,
          "minimum": 0,
          "title": "Min Silence Duration Ms",
          "type": "integer"
        },
        "speech_pad_after_ms": {
          "default": 150,
          "minimum": 0,
          "title": "Speech Pad After Ms",
          "type": "integer"
        },
        "speech_pad_before_ms": {
          "default": 120,
          "minimum": 0,
          "title": "Speech Pad Before Ms",
          "type": "integer"
        },
        "speech_threshold": {
          "default": 0.5,
          "maximum": 0.9,
          "minimum": 0.1,
          "title": "Speech Threshold",
          "type": "number"
        }
      },
      "title": "VadConfig",
      "type": "object"
    },
    "VerticalClip": {
      "additionalProperties": false,
      "properties": {
        "clip_id": {
          "minLength": 1,
          "title": "Clip Id",
          "type": "string"
        },
        "crop_focus_x": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Crop Focus X",
          "type": "number"
        },
        "end_sample": {
          "minimum": 0,
          "title": "End Sample",
          "type": "integer"
        },
        "reframe_mode": {
          "default": "center_crop_9_16",
          "enum": [
            "center_crop_9_16",
            "auto_face_tracking_yolo"
          ],
          "title": "Reframe Mode",
          "type": "string"
        },
        "start_sample": {
          "minimum": 0,
          "title": "Start Sample",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "clip_id",
        "title",
        "start_sample",
        "end_sample"
      ],
      "title": "VerticalClip",
      "type": "object"
