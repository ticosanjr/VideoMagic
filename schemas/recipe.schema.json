{
  "$defs": {
    "LlmRecipeConfig": {
      "additionalProperties": false,
      "description": "Provider selection for optional LLM steps.\n\nSecrets are referenced by environment variable name, never stored inline.",
      "properties": {
        "provider": {
          "default": "none",
          "enum": [
            "auto",
            "openai_compatible",
            "deepseek",
            "opencode_v2",
            "opencode",
            "opencode_cli",
            "none"
          ],
          "title": "Provider",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "api_key_env": {
          "default": "VIDEOWFLOW_LLM_API_KEY",
          "title": "Api Key Env",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 90.0,
          "exclusiveMinimum": 0.0,
          "maximum": 600.0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "LlmRecipeConfig",
      "type": "object"
    },
    "RecipeGroup": {
      "additionalProperties": false,
      "description": "A visual grouping area on the recipe canvas.",
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "color": {
          "default": "#38bdf8",
          "maxLength": 32,
          "title": "Color",
          "type": "string"
        },
        "x": {
          "default": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "default": 800.0,
          "maximum": 20000.0,
          "minimum": 100.0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "default": 400.0,
          "maximum": 20000.0,
          "minimum": 80.0,
          "title": "Height",
          "type": "number"
        },
        "nodes": {
          "items": {
            "type": "string"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "RecipeGroup",
      "type": "object"
    },
    "RecipeNodeUi": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "title": "Y",
          "type": "number"
        },
        "expanded": {
          "default": false,
          "title": "Expanded",
          "type": "boolean"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        },
        "width": {
          "default": 420,
          "maximum": 900,
          "minimum": 280,
          "title": "Width",
          "type": "integer"
        }
      },
      "title": "RecipeNodeUi",
      "type": "object"
    },
    "RecipeStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "needs": {
          "items": {
            "type": "string"
          },
          "title": "Needs",
          "type": "array"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "object"
        },
        "media_override": {
          "default": "",
          "title": "Media Override",
          "type": "string"
        },
        "output_mode": {
          "default": "pipeline",
          "enum": [
            "pipeline",
            "folder"
          ],
          "title": "Output Mode",
          "type": "string"
        },
        "output_dir": {
          "default": "",
          "title": "Output Dir",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "RecipeStep",
      "type": "object"
    },
    "RecipeUi": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "viewport": {
          "$ref": "#/$defs/RecipeViewport"
        },
        "nodes": {
          "additionalProperties": {
            "$ref": "#/$defs/RecipeNodeUi"
          },
          "title": "Nodes",
          "type": "object"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/RecipeGroup"
          },
          "title": "Groups",
          "type": "array"
        }
      },
      "title": "RecipeUi",
      "type": "object"
    },
    "RecipeVariable": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "default": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "enum"
          ],
          "title": "Type",
          "type": "string"
        },
        "default": {
          "default": null,
          "title": "Default"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "options": {
          "items": {},
          "title": "Options",
          "type": "array"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "title": "RecipeVariable",
      "type": "object"
    },
    "RecipeViewport": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "title": "Y",
          "type": "number"
        },
        "zoom": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 4.0,
          "title": "Zoom",
          "type": "number"
        }
      },
      "title": "RecipeViewport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "llm": {
      "$ref": "#/$defs/LlmRecipeConfig"
    },
    "ui": {
      "$ref": "#/$defs/RecipeUi"
    },
    "variables": {
      "additionalProperties": {
        "$ref": "#/$defs/RecipeVariable"
      },
      "title": "Variables",
      "type": "object"
    },
    "profiles": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Profiles",
      "type": "object"
    },
    "variants": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Variants",
      "type": "array"
    },
    "variables_resolved": {
      "additionalProperties": true,
      "title": "Variables Resolved",
      "type": "object"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/RecipeStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "steps"
  ],
  "title": "Recipe",
  "type": "object"
}
