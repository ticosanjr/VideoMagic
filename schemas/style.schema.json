{
  "$defs": {
    "PresetRule": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "default": "",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "default": "global",
          "title": "Scope",
          "type": "string"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "PresetRule",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "One style file under ``{data}/styles/<style_id>.md``.",
  "properties": {
    "aspect_ratio": {
      "default": "",
      "maxLength": 20,
      "title": "Aspect Ratio",
      "type": "string"
    },
    "beatmap_defaults": {
      "additionalProperties": true,
      "title": "Beatmap Defaults",
      "type": "object"
    },
    "body": {
      "default": "",
      "title": "Body",
      "type": "string"
    },
    "caption_preset": {
      "default": "",
      "maxLength": 80,
      "title": "Caption Preset",
      "type": "string"
    },
    "cut_rhythm": {
      "additionalProperties": true,
      "title": "Cut Rhythm",
      "type": "object"
    },
    "export_targets": {
      "items": {
        "type": "string"
      },
      "title": "Export Targets",
      "type": "array"
    },
    "fonts": {
      "items": {
        "type": "string"
      },
      "title": "Fonts",
      "type": "array"
    },
    "hook_strategy": {
      "default": "",
      "maxLength": 400,
      "title": "Hook Strategy",
      "type": "string"
    },
    "intro_strategy": {
      "default": "",
      "maxLength": 400,
      "title": "Intro Strategy",
      "type": "string"
    },
    "layout_mode": {
      "default": "",
      "maxLength": 40,
      "title": "Layout Mode",
      "type": "string"
    },
    "learned_rules": {
      "items": {
        "$ref": "#/$defs/PresetRule"
      },
      "maxItems": 15,
      "title": "Learned Rules",
      "type": "array"
    },
    "max_static_sec": {
      "default": 4.0,
      "maximum": 120.0,
      "minimum": 0.1,
      "title": "Max Static Sec",
      "type": "number"
    },
    "min_silence_ms": {
      "default": 400,
      "maximum": 10000,
      "minimum": 0,
      "title": "Min Silence Ms",
      "type": "integer"
    },
    "motion_engine": {
      "default": "auto",
      "maxLength": 40,
      "title": "Motion Engine",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "palette": {
      "items": {
        "type": "string"
      },
      "title": "Palette",
      "type": "array"
    },
    "platforms": {
      "items": {
        "type": "string"
      },
      "title": "Platforms",
      "type": "array"
    },
    "safe_zones": {
      "additionalProperties": true,
      "title": "Safe Zones",
      "type": "object"
    },
    "schema_version": {
      "default": 2,
      "maximum": 2,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sound_design": {
      "additionalProperties": true,
      "title": "Sound Design",
      "type": "object"
    },
    "style_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Style Id",
      "type": "string"
    },
    "target_lufs": {
      "default": -16.0,
      "maximum": -5.0,
      "minimum": -30.0,
      "title": "Target Lufs",
      "type": "number"
    },
    "updated_at": {
      "default": "",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "style_id",
    "name"
  ],
  "title": "StyleDefinition",
  "type": "object"
}
